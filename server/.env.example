# Backend listener
PORT=5000
NODE_ENV=development

# Required: MongoDB connection string for the CareOS database
MONGO_URI=

# Required: generate independent, high-entropy secrets for each token type
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Optional token lifetime overrides (defaults: 15m and 7d)
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Optional: allowed browser origin for CORS (defaults to http://localhost:5173)
CLIENT_URL=http://localhost:5173

# Optional: invitation lifetime in hours (defaults to 48)
INVITATION_EXPIRES_IN_HOURS=48

# Document storage: region defaults to ap-south-1. Set the existing private bucket;
# blank currently triggers a hard-coded fallback in s3.util.js, so do not use S3 until verified.
AWS_REGION=ap-south-1
S3_DOCUMENT_BUCKET=
# Optional KMS key ID/ARN; if empty, AWS-managed S3 KMS key selection is used
KMS_KEY_ID=

# Optional document policy overrides (defaults: 15 MB, 300s, emergency 900s)
MAX_DOCUMENT_FILE_SIZE_MB=15
PRESIGNED_URL_EXPIRES_SECONDS=300
EMERGENCY_PRESIGNED_URL_EXPIRES_SECONDS=900

# Test-only switch; leave false for real AWS calls
USE_MOCK_S3=false
